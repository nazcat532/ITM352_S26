{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "target": "ESNext",
    "lib": ["ESNext", "DOM"],

    "checkJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "strict": false,
    "types": []
  },

  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/components/ui",
    "src/api",
    "src/lib"
  ]
}